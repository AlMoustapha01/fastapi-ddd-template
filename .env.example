# Application
APP__NAME="FastAPI DDD Template"
APP__ENVIRONMENT=local
APP__DOCS_ENABLED=true

# Database
DATABASE__HOST=localhost
DATABASE__PORT=5432
DATABASE__USER=postgres
DATABASE__PASSWORD=postgres
DATABASE__NAME=app

# CORS (JSON list, empty disables CORS)
CORS__ALLOW_ORIGINS=[]

# Logging
LOG__LEVEL=INFO
